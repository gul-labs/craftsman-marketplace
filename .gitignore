.DS_Store
node_modules/
__pycache__/
*.pyc

# .remember/ is local session memory, never shared, never shipped.
.remember/

# Private feedback inbox. Drop raw reviewer notes, screenshots, and exports here;
# it is intentionally never committed or published.
.feedback/

# Field reports and audit output from dogfooding runs. Never publish: they describe real systems.
.craftsman-field-report.md
.craftsman/

# Local Codex review reports (contain local absolute paths; kept on disk, not published)
docs-review-*.md

# Per-release Codex review rounds. Same reason as docs-review-*.md, plus they quote the real
# engagement figures the reviews were checking the guidance had been scrubbed of.
.reviews/
